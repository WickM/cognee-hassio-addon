#!/usr/bin/bashio
# s6-overlay cont-init.d/10-config — runs once at boot, before services.
# Validates addon options, prepares data dirs, logs diagnostics.
# Tolerant: log + non-zero exit only on fatal misconfig. Best-effort on the rest.
set +e



echo "[10-config] uid=$(id -u) cwd=$(pwd)"
# bashio functions are loaded by the #!/usr/bin/bashio shebang above.
# Verify it worked by checking for a known function; fall back to jq if not.
if declare -F bashio::config >/dev/null 2>&1; then
    echo "[10-config] bashio loaded: OK"
else
    echo "[10-config] bashio NOT loaded — _bashio_config() will use jq fallback"
fi
echo "[10-config] python: $(command -v python || command -v python3 || echo 'NOT FOUND')"
echo "[10-config] cognee on PATH: $(command -v cognee || echo 'NOT FOUND')"
# shebang sets $0 to this script path, which bashio bootstrap needs

# ---- Read options from supervisor (or fall back to env / defaults) ----
# bashio::config reads from /data/options.json (HA's addon-config-store).
# If bashio is unavailable for any reason, fall back to jq directly on the same file.
OPTIONS_FILE="/data/options.json"
_bashio_config() {
    local key="$1"
    local default="$2"
    if declare -F bashio::config >/dev/null 2>&1; then
        bashio::config "${key}" "${default}"
    elif [ -f "${OPTIONS_FILE}" ]; then
        local val
        val="$(jq -r --arg k "${key}" 'if (.[$k] == null) then empty else .[$k] end' "${OPTIONS_FILE}" 2>/dev/null)"
        if [ -z "${val}" ]; then echo "${default}"; else echo "${val}"; fi
    else
        echo "${default}"
    fi
}

DATA_PATH="$(_bashio_config 'data_path' '/share/cognee')"
LLM_API_KEY="$(_bashio_config 'llm_api_key' '')"
EMBEDDING_API_KEY="$(_bashio_config 'embedding_api_key' '')"
LLM_PROVIDER="$(_bashio_config 'llm_provider' 'openai')"
LLM_MODEL="$(_bashio_config 'llm_model' 'minimax/minimax-m3')"
EMBEDDING_PROVIDER="$(_bashio_config 'embedding_provider' 'openai')"
EMBEDDING_MODEL="$(_bashio_config 'embedding_model' 'text-embedding-3-small')"
EMBEDDING_DIMENSIONS="$(_bashio_config 'embedding_dimensions' '1536')"
COGNEE_PORT="$(_bashio_config 'cognee_port' '8000')"
AGENT_MODE="$(_bashio_config 'agent_mode' 'true')"
LOG_LEVEL="$(_bashio_config 'log_level' 'INFO')"

# ---- Validations (fatal) ----
if [ -z "${LLM_API_KEY}" ]; then
    if declare -F bashio::exit.nok >/dev/null 2>&1; then
        bashio::exit.nok "llm_api_key is empty. Set it in the add-on Configuration tab (HA UI)."
    else
        echo "[10-config] FATAL: llm_api_key is empty. Set it in the add-on Configuration tab (HA UI)."
        exit 1
    fi
fi

# If embedding_api_key is empty, fall back to llm_api_key (common for gateway setups
# where one key proxies to multiple model providers).
if [ -z "${EMBEDDING_API_KEY}" ] && [ -n "${LLM_API_KEY}" ]; then
    if declare -F bashio::log.warning >/dev/null 2>&1; then
        bashio::log.warning "embedding_api_key empty — falling back to llm_api_key"
    else
        echo "[10-config] WARN: embedding_api_key empty — falling back to llm_api_key"
    fi
    EMBEDDING_API_KEY="${LLM_API_KEY}"
fi

# ---- Prepare data dirs ----
mkdir -p "${DATA_PATH}" "${DATA_PATH}/.cognee" "${DATA_PATH}/logs" "${DATA_PATH}/cache"
chmod -R 777 "${DATA_PATH}"
echo "[10-config] data dir ready: $(ls -ld ${DATA_PATH})"

# ---- Export to env for the cognee service ----
# Use bashio::var.export so the s6 service inherits cleanly.
export DATA_PATH LLM_API_KEY EMBEDDING_API_KEY \
       LLM_PROVIDER LLM_MODEL \
       EMBEDDING_PROVIDER EMBEDDING_MODEL EMBEDDING_DIMENSIONS \
       COGNEE_PORT AGENT_MODE LOG_LEVEL

# Optional base URLs
LLM_BASE_URL="$(_bashio_config 'llm_base_url' '')"
EMBEDDING_BASE_URL="$(_bashio_config 'embedding_base_url' '')"
[ -n "${LLM_BASE_URL}" ] && export LLM_BASE_URL
[ -n "${EMBEDDING_BASE_URL}" ] && export EMBEDDING_BASE_URL

# Persist a summary (no secrets) for post-mortem debugging
{
    echo "DATA_PATH=${DATA_PATH}"
    echo "LLM_PROVIDER=${LLM_PROVIDER}"
    echo "LLM_MODEL=${LLM_MODEL}"
    echo "LLM_BASE_URL=${LLM_BASE_URL:-<unset>}"
    echo "EMBEDDING_PROVIDER=${EMBEDDING_PROVIDER}"
    echo "EMBEDDING_MODEL=${EMBEDDING_MODEL}"
    echo "EMBEDDING_DIMENSIONS=${EMBEDDING_DIMENSIONS}"
    echo "EMBEDDING_BASE_URL=${EMBEDDING_BASE_URL:-<unset>}"
    echo "COGNEE_PORT=${COGNEE_PORT}"
    echo "AGENT_MODE=${AGENT_MODE}"
    echo "LOG_LEVEL=${LOG_LEVEL}"
    echo "LLM_API_KEY_LEN=${#LLM_API_KEY}"
    echo "EMBEDDING_API_KEY_LEN=${#EMBEDDING_API_KEY}"
} > "${DATA_PATH}/logs/options.env"

echo "[10-config] options written to ${DATA_PATH}/logs/options.env"
echo "[10-config] OK — handing off to cognee service"
